[Unit]
Description=Inventaris Bengkel Motor (Flask via Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rizki06
Group=rizki06
WorkingDirectory=/home/rizki06/inventaris-bengkel-motor
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/rizki06/inventaris-bengkel-motor/venv/bin/gunicorn --workers 1 --threads 2 --bind 127.0.0.1:8000 --timeout 30 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target